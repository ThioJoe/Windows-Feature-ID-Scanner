    <parent buildCompare="GE" revisionCompare="GE">
      <assemblyIdentity name="Microsoft-Windows-WinOcr-Package" version="10.0.28000.3501" processorArchitecture="amd64" language="neutral" buildType="release" publicKeyToken="31bf3856ad364e35" />
    </parent>
    <localizedStrings>
      <string language="ar-SA" displayName="Windows TIFF IFilter" description="تمكين الفهرسة والبحث لملفات بتنسيق ملف صور ذي علامات (TIFF) باستخدام التعرّف البصري على الأحرف  (OCR)." />
      <string language="bg-BG" displayName="Windows TIFF IFilter" description="Разрешава индексирането и търсенето на файлове с маркирани изображения (TIFF) чрез оптично разпознаване на знаци (OCR)." />
      <string language="cs-CZ" displayName="Filtr Windows TIFF IFilter" description="Umožňuje indexování a vyhledávání souborů TIFF (Tagged Image File Format) pomocí technologie OCR." />
      <string language="da-DK" displayName="Windows TIFF IFilter" description="Muliggør indeksering af og søgning i TIFF-filer (Tagged Image File Format) ved hjælp af OCR (optisk tegngenkendelse)." />
      <string language="de-DE" displayName="Windows-TIFF-IFilter" description="Ermöglicht die Indizierung und Suche von Dateien im Tagged Image File Format (TIFF) mithilfe von Optical Character Recognition (OCR)." />
      <string language="el-GR" displayName="Windows TIFF IFilter" description="Ενεργοποιεί τη δημιουργία ευρετηρίου και την αναζήτηση για αρχεία TIFF (Μορφή αρχείων εικόνων με ετικέτες), χρησιμοποιώντας οπτική αναγνώριση χαρακτήρων (OCR)." />
      <string language="en-GB" displayName="Windows TIFF IFilter" description="Enables the indexing and searching of Tagged Image File Format (TIFF) files using Optical Character Recognition (OCR)." />
      <string language="en-US" displayName="Windows TIFF IFilter" description="Enables the indexing and searching of Tagged Image File Format (TIFF) files using Optical Character Recognition (OCR)." />
      <string language="es-ES" displayName="Windows TIFF IFilter" description="Habilita la indexación y la búsqueda de archivos TIFF (Tagged Image File Format) mediante el reconocimiento óptico de caracteres (OCR)." />
      <string language="es-MX" displayName="Windows TIFF IFilter" description="Habilita la indexación y la búsqueda de archivos TIFF (Tagged Image File Format) mediante el reconocimiento óptico de caracteres (OCR)." />
      <string language="et-EE" displayName="Windows TIFF IFilter" description="Lubab sildistatud kujutise failivorminguga (TIFF) failide indekseerimise ja otsimise optilise märgituvastuse (OCR) abil." />
      <string language="fi-FI" displayName="Windows TIFF IFilter -suodatin" description="Ottaa käyttöön TIFF-tiedostojen indeksoinnin ja haun optisella merkkien tunnistamisella (OCR)." />
      <string language="fr-CA" displayName="IFilter TIFF Windows" description="Active l’indexation et la recherche de fichiers TIFF (Tagged Image File Format) à l’aide de la reconnaissance optique de caractères (OCR)." />
      <string language="fr-FR" displayName="IFilter TIFF Windows" description="Active l’indexation et la recherche de fichiers TIFF (Tagged Image File Format) à l’aide de la reconnaissance optique de caractères (OCR)." />
      <string language="he-IL" displayName="Windows TIFF IFilter" description="מתן אפשרות ליצירת אינדקס וחיפוש של קבצי תבנית קובץ גרפי מתויגת (TIFF) באמצעות זיהוי תווים אופטי (OCR)." />
      <string language="hr-HR" displayName="Windows TIFF IFilter" description="Omogućuje indeksiranje i pretraživanje datoteka u obliku Tagged Image File Format (TIFF) pomoću značajke optičkog prepoznavanja znakova (OCR-a)." />
      <string language="hu-HU" displayName="Windows TIFF IFilter indexszűrő" description="Az optikai karakterfelismerés (OCR) használatával lehetővé teszi a TIFF-formátumú fájlok indexelését és keresését." />
      <string language="it-IT" displayName="IFilter TIFF di Windows" description="Consente l'indicizzazione e la ricerca di file TIFF (Tagged Image File Format) tramite il riconoscimento ottico dei caratteri (OCR)." />
      <string language="ja-JP" displayName="Windows TIFF IFilter" description="光学式文字認識を使用する Tagged Image File Format (TIFF) ファイルのインデックス作成と検索を有効にします。" />
      <string language="ko-KR" displayName="Windows TIFF IFilter" description="OCR(광학 문자 인식)을 통해 TIFF(Tagged Image File Format) 파일을 색인 및 검색할 수 있도록 합니다." />
      <string language="lt-LT" displayName="Windows TIFF IFilter" description="Įgalina TIFF formato failų paiešką ir indeksavimą naudojant optinį ženklų atpažinimą (OCR)." />
      <string language="lv-LV" displayName="Windows TIFF IFiltrs" description="Iespējo tagu attēlu failu formāta (TIFF) failu indeksēšanu un meklēšanu, izmantojot optisko rakstzīmju pazīšanu (OCR)." />
      <string language="nb-NO" displayName="Windows TIFF IFilter" description="Aktiverer indeksering av og søk etter TIFF-filer (Tagged Image File Format) med optisk tegngjenkjenning (OCR)." />
      <string language="nl-NL" displayName="Windows TIFF IFilter" description="Hiermee wordt het indexeren en zoeken van TIFF-bestanden (Tagged Image File Format) met OCR (Optical Character Recognition) ingeschakeld." />
      <string language="pl-PL" displayName="Filtr TIFF IFilter systemu Windows" description="Włącza indeksowanie i wyszukiwanie plików TIFF (Tagged Image File Format) przy użyciu optycznego rozpoznawania znaków (OCR)." />
      <string language="qps-plocm" displayName="‏‏أبع[Windows TIFF IFilter]לף" description="‏‏أبع[Enables the indexing and searching of Tagged Image File Format (TIFF) files using Optical Character Recognition (OCR).]לף" />
      <string language="qps-ploc" displayName="[Wme4N][Ẁîлδóẅŝ ŤĬ₣₣ Ì₣ϊŀτзѓ !!! !]" description="[vAw87][Зήáъł℮ŝ ťħє ìпδέжĩńğ аňď śĕάřċђϊпĝ ŏƒ Ťâģğėδ Ĭmǻġε ₣îĺз ₣ôґmâτ (ŢÎ₣₣) ƒΐĺзş µŝïиĝ Ορτΐсдŀ Çћåгăčτěѓ Ѓэćöĝиîţìǿп (ŎÇЃ). !!! !!! !!! !!! !!! !!! !!! !!! !!]" />
      <string language="pt-BR" displayName="Windows TIFF IFilter" description="Habilita a indexação e a pesquisa de arquivos Formato de Arquivo de imagem rotulada (TIFF) usando Reconhecimento Óptico de Caracteres (OCR)." />
      <string language="pt-PT" displayName="Windows TIFF IFilter" description="Ativa a ferramenta de indexação e pesquisa de ficheiros no formato TIFF (Tagged Image File Format) utilizando OCR (Reconhecimento Ótico de Carateres)." />
      <string language="ro-RO" displayName="Windows TIFF IFilter" description="Permite indexarea și căutarea fișierelor în format TIFF utilizând recunoașterea optică a caracterelor (OCR)." />
      <string language="ru-RU" displayName="Фильтр Windows TIFF IFilter" description="Обеспечивает индексирование и поиск в файлах формата TIFF с помощью функции распознавания текста." />
      <string language="sk-SK" displayName="Windows TIFF IFilter" description="Umožňuje indexovanie a prehľadávanie súborov vo formáte TIFF (Tagged Image File Format) pomocou technológie optického rozpoznávania znakov (OCR)." />
      <string language="sl-SI" displayName="Windows TIFF IFilter" description="Omogoča indeksiranje in iskanje datotek TIFF  z optičnim prepoznavanjem znakov (OCR)." />
      <string language="sr-Latn-RS" displayName="Windows TIFF IFilter" description="Omogućava indeksiranje i pretraživanje Tagged Image File Format (TIFF) datoteka pomoću optičkog prepoznavanja znakova (OCR)." />
      <string language="sv-SE" displayName="Windows TIFF IFilter" description="Aktiverar indexering och sökning efter TIFF-filer (Tagged Image File Format) med OCR (optisk teckenläsning)." />
      <string language="th-TH" displayName="Windows TIFF IFilter" description="เปิดใช้งานการทำดัชนีและการค้นหาแฟ้ม Tagged Image File Format (TIFF) โดยใช้การรู้จำอักขระด้วยแสง (OCR)" />
      <string language="tr-TR" displayName="Windows TIFF IFilter" description="Etiketli Resim Dosyası Biçimi (TIFF) dosyalarının Optik Karakter Tanıma (OCR) kullanılarak dizine alınmasına ve aranmasına olanak tanır." />
      <string language="uk-UA" displayName="Windows TIFF IFilter" description="Увімкнення індексування та пошуку файлів формату TIFF за допомогою оптичного розпізнавання тексту (OCR)." />
      <string language="zh-CN" displayName="Windows TIFF IFilter" description="启用使用光学字符识别(OCR)进行的对标记图像文件格式(TIFF)文件的索引和搜索。" />
      <string language="zh-TW" displayName="Windows TIFF IFilter" description="啟用標記的影像檔案格式 (TIFF) 檔案之索引和搜尋功能 (使用光學字元辨識 (OCR))。" />
    </localizedStrings>
