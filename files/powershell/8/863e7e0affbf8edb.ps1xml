<?xml version="1.0" encoding="utf-8"?><Types>
	<Type>
		<Name>System.Security.Cryptography.X509Certificates.X509Certificate2</Name>
		<Members>

			<ScriptProperty>
				<Name>EnrollmentPolicyEndPoint</Name>
				<GetScriptBlock>
					new-object Microsoft.CertificateServices.Commands.EnrollmentEndPointProperty -argumentlist $this,$true
				</GetScriptBlock>
				<SetScriptBlock>
					$e = $this.EnrollmentPolicyEndPoint
                                        $e.CopyUrlAndAuthType($args[0])
				</SetScriptBlock>
			</ScriptProperty>
			<ScriptProperty>
				<Name>EnrollmentServerEndPoint</Name>
				<GetScriptBlock>
					new-object Microsoft.CertificateServices.Commands.EnrollmentEndPointProperty -argumentlist $this,$false
				</GetScriptBlock>
				<SetScriptBlock>
					$e = $this.EnrollmentServerEndPoint
                                        $e.CopyUrlAndAuthType($args[0])
				</SetScriptBlock>
			</ScriptProperty>
			<ScriptProperty>
				<Name>PolicyId</Name>
				<GetScriptBlock>
					[Microsoft.CertificateServices.Commands.PolicyIdProperty]::ReadPolicyId($this)
				</GetScriptBlock>
				<SetScriptBlock>
                                        $policyId = $args[0]
					[Microsoft.CertificateServices.Commands.PolicyIdProperty]::WritePolicyId($this,$policyId)
				</SetScriptBlock>
			</ScriptProperty>

		</Members>
	</Type>
</Types>
