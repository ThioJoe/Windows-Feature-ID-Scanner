<?xml version="1.0" encoding="utf-8"?>
<policyDefinitions xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" revision="11.0" schemaVersion="1.0" xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <policyNamespaces>
    <target prefix="OOBE" namespace="Microsoft.Policies.OOBE  " />
    <using prefix="windows" namespace="Microsoft.Policies.Windows" />
  </policyNamespaces>
  <resources minRequiredRevision="1.0" />
  <categories>
    <category name="OOBECategory" displayName="$(string.OOBECategory_DisplayName)" explainText="$(string.OOBECategory_Explain)">
      <parentCategory ref="windows:WindowsComponents" />
    </category>
  </categories>
  <policies>
    <policy name="DisablePrivacyExperience"
            class="Both"
            displayName="$(string.DisablePrivacyExperience)"
            explainText="$(string.DisablePrivacyExperience_Explain)"
            key="Software\Policies\Microsoft\Windows\OOBE"
            valueName="DisablePrivacyExperience"
            >
      <parentCategory ref="OOBECategory" />
      <supportedOn ref="windows:SUPPORTED_Windows_10_0_RS5" />
      <enabledValue>
        <decimal value="1" />
      </enabledValue>
      <disabledValue>
        <decimal value="0" />
      </disabledValue>
    </policy>
    <policy name="AllowOOBEUpdates"
            class="Machine"
            displayName="$(string.AllowOOBEUpdates)"
            explainText="$(string.AllowOOBEUpdates_Explain)"
            key="Software\Policies\Microsoft\Windows\OOBE"
            valueName="AllowOOBEUpdates"
            >
      <parentCategory ref="OOBECategory" />
      <supportedOn ref="windows:SUPPORTED_Windows_11_0_NOSERVER" />
      <enabledValue>
        <decimal value="1" />
      </enabledValue>
      <disabledValue>
        <decimal value="0" />
      </disabledValue>
    </policy>
    <policy name="ConfigureOOBEUpdatesSkipTimer"
            class="Machine"
            displayName="$(string.ConfigureOOBEUpdatesSkipTimer)"
            explainText="$(string.ConfigureOOBEUpdatesSkipTimer_Explain)"
            presentation="$(presentation.ConfigureOOBEUpdatesSkipTimer)"
            key="Software\Policies\Microsoft\Windows\OOBE"
            >
      <parentCategory ref="OOBECategory" />
      <supportedOn ref="windows:SUPPORTED_Windows_11_0_NOSERVER" />
      <elements>
        <enum id="ConfigureOOBEUpdatesSkipTimer_Enum"
              valueName="ConfigureOOBEUpdatesSkipTimer">
          <item displayName="$(string.ConfigureOOBEUpdatesSkipTimer_Immediately)">
            <value>
              <decimal value="0" />
            </value>
          </item>
          <item displayName="$(string.ConfigureOOBEUpdatesSkipTimer_15Minutes)">
            <value>
              <decimal value="15" />
            </value>
          </item>
          <item displayName="$(string.ConfigureOOBEUpdatesSkipTimer_20Minutes)">
            <value>
              <decimal value="20" />
            </value>
          </item>
          <item displayName="$(string.ConfigureOOBEUpdatesSkipTimer_30Minutes)">
            <value>
              <decimal value="30" />
            </value>
          </item>
          <item displayName="$(string.ConfigureOOBEUpdatesSkipTimer_45Minutes)">
            <value>
              <decimal value="45" />
            </value>
          </item>
          <item displayName="$(string.ConfigureOOBEUpdatesSkipTimer_60Minutes)">
            <value>
              <decimal value="60" />
            </value>
          </item>
        </enum>
      </elements>
    </policy>
  </policies>
</policyDefinitions>
