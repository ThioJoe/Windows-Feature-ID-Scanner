  },
  {
    "id": "SummaryPage",
    "type": "summaryPage",
    "title": "ガイドのまとめ (13/13)",
    "content": [
      {
        "id": "Paragraph1",
        "type": "TextBlock",
        "accessKey": "",
        "headingLevel": "none",
        "text": "お疲れさまでした。 ガイドはこれで終わりですが、 お役に立てたでしょうか。 各セクションをもう一度確認するには、下のリンクをご利用ください。"
      },
      {
        "id": "Paragraph2",
        "type": "TextBlock",
        "accessKey": "",
        "headingLevel": "none",
        "text": "さらに詳しい情報については、<hyperlink id='UserGuideLink' url='https://go.microsoft.com/fwlink/p/?linkid=873381'>ナレーター ユーザー ガイド</hyperlink>をご覧ください。"
      },
      {
        "id": "LinkWelcomePage",
        "type": "HyperlinkButton",
        "accessKey": "",
        "text": "ナレーターへようこそ (1/13)",
        "url": "",
