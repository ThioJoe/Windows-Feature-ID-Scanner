          "targetId": "ScanModePage"
        }
      },
      {
        "id": "LinkReadingWordsPage",
        "type": "HyperlinkButton",
        "accessKey": "",
        "text": "単語と文字の読み上げ (4/13)",
        "url": "",
        "isDefaultFocus": false,
        "action": {
          "type": "Navigate",
          "targetId": "ReadingWordsPage"
        }
      },
      {
        "id": "LinkHeadingsPage",
        "type": "HyperlinkButton",
