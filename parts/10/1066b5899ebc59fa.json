{"1000":"Microsoft PnP Utility","1001":"PNPUTIL [/add-driver <...> | /delete-driver <...> |\r\n","1002":"         /export-driver <...> | /enum-drivers [<...>] |\r\n","1003":"         /enum-devices [<...>] | /enum-devicetree [<...>] |\r\n","1004":"         /disable-device <...> | /enable-device <...> |\r\n","1005":"         /restart-device <...> | /remove-device <...> |\r\n","1006":"         /scan-devices [<...>] | /enum-classes [<...>] |\r\n","1007":"         /enum-interfaces [<...>] | /enum-containers [<...>] | /?]\r\n","1008":"\r\n","1009":"Commands:\r\n","1010":"\r\n","1021":"  /add-driver <filename.inf | *.inf> [/subdirs] [/install] [/reboot]\r\n","1022":"\r\n","1023":"    Add driver package(s) into the driver store.\r\n","1024":"      /subdirs - traverse sub directories for driver packages.\r\n","1025":"      /install - install/update drivers on any matching devices.\r\n","1026":"@!      /configure - configure driver state into the system.\r\n","1027":"      /reboot - reboot system if needed to complete the operation.\r\n","1028":"\r\n","1029":"    Examples:\r\n","1030":"      Add driver package:\r\n","1031":"        pnputil /add-driver x:\\driver.inf\r\n","1032":"      Add multiple driver packages:\r\n","1033":"        pnputil /add-driver c:\\oem\\*.inf\r\n","1034":"      Add and install driver package:\r\n","1035":"        pnputil /add-driver device.inf /install\r\n","1036":"\r\n","1051":"  /delete-driver <oem#.inf> [/uninstall] [/force] [/reboot]\r\n","1052":"\r\n","1053":"    Delete driver package from the driver store.\r\n","1054":"      /uninstall - uninstall driver package from any devices using it.\r\n","1055":"@!      /unconfigure - unconfigure driver state from the system.\r\n","1056":"      /force - delete driver package even when it is in use by devices.\r\n","1057":"      /reboot - reboot system if needed to complete the operation.\r\n","1058":"\r\n","1059":"    Examples:\r\n","1060":"      Delete driver package:\r\n","1061":"        pnputil /delete-driver oem0.inf\r\n","1062":"      Force delete driver package:\r\n","1063":"        pnputil /delete-driver oem1.inf /force\r\n","1064":"\r\n","1081":"  /export-driver <oem#.inf | *> <target directory>\r\n","1082":"\r\n","1083":"    Export driver package(s) from the driver store into a target directory.\r\n","1084":"\r\n","1085":"    Examples:\r\n","1086":"      Export driver package:\r\n","1087":"        pnputil /export-driver oem6.inf .\r\n","1088":"      Export all driver packages:\r\n","1089":"        pnputil /export-driver * c:\\backup\r\n","1090":"\r\n","1101":"  /enum-drivers [/class <name | GUID>] [/files] [/ids] [/devices]\r\n","1102":"                [/format <txt | xml | csv>] [/output-file [<filename>]]\r\n","1104":"\r\n","1105":"    Enumerate all 3rd party driver packages in the driver store.\r\n","1106":"@!      /inbox - include inbox driver packages.\r\n","1107":"      /class <name | GUID> - filter by driver class name or GUID.\r\n","1108":"      /files - enumerate all driver package files.\r\n","1109":"      /ids - display driver package and family IDs.\r\n","1110":"      /devices - display devices with driver package installed.\r\n","1111":"      /format - format output as text, XML, or CSV.\r\n","1112":"      /output-file [<filename>] - write output to optional filename.\r\n","1113":"\r\n","1114":"    Examples:\r\n","1115":"      Enumerate all OEM driver packages:\r\n","1116":"        pnputil /enum-drivers\r\n","1117":"      Enumerate all OEM driver packages of a specific class:\r\n","1118":"        pnputil /enum-drivers /class \"System\"\r\n","1119":"      Enumerate all OEM driver packages and show driver files:\r\n","1120":"        pnputil /enum-drivers /files\r\n","1121":"\r\n","1131":"  /enum-devices [/connected | /disconnected] [/class <name | GUID>]\r\n","1132":"                [/instanceid <instance ID> | /deviceid <device ID>]\r\n","1133":"                [/problem [<code>]] [/bus [<name | GUID>]] [/deviceids]\r\n","1134":"                [/relations] [/services] [/stack] [/location] [/drivers]\r\n","1135":"                [/interfaces] [/properties] [/resources]\r\n","1136":"                [/format <txt | xml | csv>] [/output-file [<filename>]]\r\n","1137":"\r\n","1138":"    Enumerate all devices on the system.\r\n","1139":"      /connected | /disconnected - filter by connected devices or\r\n","1140":"                                   filter by disconnected devices.\r\n","1141":"      /class <name | GUID> - filter by device class name or GUID.\r\n","1142":"      /instanceid <instance ID> - filter by device instance ID.\r\n","1143":"      /deviceid <device ID> - filter by device hardware/compatible ID.\r\n","1144":"      /problem [<code>] - filter by devices with problems or\r\n","1145":"                          filter by specific problem code.\r\n","1146":"      /bus [<name | GUID>] - display bus enumerator name and bus type GUID or\r\n","1147":"                             filter by bus enumerator name or bus type GUID.\r\n","1148":"      /deviceids - display hardware/compatible IDs.\r\n","1149":"      /relations - display parent and child device relations.\r\n","1150":"      /services - display device services.\r\n","1151":"      /stack - display effective device stack information.\r\n","1152":"      /location - display location information and paths.\r\n","1153":"      /drivers - display matching and installed drivers.\r\n","1154":"      /interfaces - display device interfaces.\r\n","1155":"      /properties - display all device properties.\r\n","1156":"      /resources - display device resources.\r\n","1157":"      /format - format output as text, XML, or CSV.\r\n","1158":"      /output-file [<filename>] - write output to optional filename.\r\n","1159":"\r\n","1160":"    Examples:\r\n","1161":"      Enumerate only connected devices on the system:\r\n","1162":"        pnputil /enum-devices /connected\r\n","1163":"      Enumerate device with specific instance ID:\r\n","1164":"        pnputil /enum-devices /instanceid \"ACPI\\PNP0A08\\1\"\r\n","1165":"      Enumerate all devices with specific hardware/compatible ID:\r\n","1166":"        pnputil /enum-devices /deviceid \"USB\\Class_03\"\r\n","1167":"      Enumerate all devices with specific class:\r\n","1168":"        pnputil /enum-devices /class Display\r\n","1169":"        pnputil /enum-devices /class {4d36e97d-e325-11ce-bfc1-08002be10318}\r\n","1170":"      Enumerate all devices with specific problem code:\r\n","1171":"        pnputil /enum-devices /problem 28\r\n","1172":"        pnputil /enum-devices /problem 0xA\r\n","1173":"      Enumerate all devices with specific bus:\r\n","1174":"        pnputil /enum-devices /bus PCI\r\n","1175":"        pnputil /enum-devices /bus {c8ebdfb0-b510-11d0-80e5-00a0c92542e3}\r\n","1176":"      Enumerate all devices with problems and display hardware/compatible IDs:\r\n","1177":"        pnputil /enum-devices /problem /deviceids\r\n","1178":"\r\n","1191":"  /enum-interfaces [/enabled | /disabled] [/class <GUID>] [/instanceid <instance ID>]\r\n","1192":"                   [/properties] [/format <txt | xml | csv>] [/output-file [<filename>]]\r\n","1193":"\r\n","1194":"    Enumerate all device interfaces on the system.\r\n","1195":"      /enabled | /disabled - filter by enabled interfaces or\r\n","1196":"                             filter by disabled interfaces.\r\n","1197":"      /class <GUID> - filter by interface class GUID.\r\n","1198":"      /instanceid <instance ID> - filter by device instance ID.\r\n","1199":"      /properties - display all interface properties.\r\n","1200":"      /format - format output as text, XML, or CSV.\r\n","1201":"      /output-file [<filename>] - write output to optional filename.\r\n","1202":"\r\n","1203":"    Examples:\r\n","1204":"      Enumerate only enabled interfaces on the system:\r\n","1205":"        pnputil /enum-interfaces /enabled\r\n","1206":"      Enumerate all interfaces with specific interface class GUID:\r\n","1207":"        pnputil /enum-interfaces /class {884b96c3-56ef-11d1-bc8c-00a0c91405dd}\r\n","1208":"\r\n","1210":"  /enum-classes [/class <name | GUID>] [/services] [/format <txt | xml | csv>]\r\n","1211":"                [/output-file [<filename>]]\r\n","1212":"\r\n","1213":"    Enumerate all device setup classes on the system.\r\n","1214":"      /class <name | GUID> - filter by device class name or GUID.\r\n","1215":"      /services - display device class services.\r\n","1216":"      /format - format output as text, XML, or CSV.\r\n","1217":"      /output-file [<filename>] - write output to optional filename.\r\n","1218":"\r\n","1219":"    Examples:\r\n","1220":"      Enumerate all device setup classes on the system:\r\n","1221":"        pnputil /enum-classes\r\n","1222":"      Enumerate information for a specific device setup class:\r\n","1223":"        pnputil /enum-classes /class Display\r\n","1224":"        pnputil /enum-classes /class {4d36e968-e325-11ce-bfc1-08002be10318}\r\n","1225":"\r\n","1231":"  /disable-device [<instance ID> | /deviceid <device ID>] [/class <name | GUID>]\r\n","1232":"                  [/bus <name | GUID>] [/reboot] [/force]\r\n","1233":"\r\n","1234":"    Disable devices on the system.\r\n","1235":"      /deviceid <device ID> - disable all devices with matching device ID.\r\n","1236":"      /class <name | GUID> - filter by device class name or GUID.\r\n","1237":"      /bus <name | GUID> - filter by bus enumerator name or bus type GUID.\r\n","1238":"      /reboot - reboot system if needed to complete the operation.\r\n","1239":"      /force - disable even if device provides critical system functionality.\r\n","1240":"\r\n","1241":"    Examples:\r\n","1242":"      Disable device:\r\n","1243":"        pnputil /disable-device \"USB\\VID_045E&PID_00DB\\6&870CE29&0&1\"\r\n","1244":"      Disable all devices with specific hardware/compatible ID:\r\n","1245":"        pnputil /disable-device /deviceid \"USB\\Class_03\"\r\n","1246":"      Disable all devices of a specific class on a specific bus:\r\n","1247":"        pnputil /disable-device /class \"USB\" /bus \"PCI\"\r\n","1248":"\r\n","1261":"  /enable-device [<instance ID> | /deviceid <device ID>] [/class <name | GUID>]\r\n","1262":"                 [/bus <name | GUID>] [/reboot]\r\n","1263":"\r\n","1264":"    Enable devices on the system.\r\n","1265":"      /deviceid <device ID> - enable all devices with matching device ID.\r\n","1266":"      /class <name | GUID> - filter by device class name or GUID.\r\n","1267":"      /bus <name | GUID> - filter by bus enumerator name or bus type GUID.\r\n","1268":"      /reboot - reboot system if needed to complete the operation.\r\n","1269":"\r\n","1270":"    Examples:\r\n","1271":"      Enable device:\r\n","1272":"        pnputil /enable-device \"USB\\VID_045E&PID_00DB\\6&870CE29&0&1\"\r\n","1273":"      Enable all devices with specific hardware/compatible ID:\r\n","1274":"        pnputil /enable-device /deviceid \"USB\\Class_03\"\r\n","1275":"      Enable all devices of a specific class on a specific bus:\r\n","1276":"        pnputil /enable-device /class \"USB\" /bus \"PCI\"\r\n","1277":"\r\n","1301":"  /restart-device [<instance ID> | /deviceid <device ID>] [/class <name | GUID>]\r\n","1302":"                  [/bus <name | GUID>] [/reboot]\r\n","1303":"\r\n","1304":"    Restart devices on the system.\r\n","1305":"      /deviceid <device ID> - restart all devices with matching device ID.\r\n","1306":"      /class <name | GUID> - filter by device class name or GUID.\r\n","1307":"      /bus <name | GUID> - filter by bus enumerator name or bus type GUID.\r\n","1308":"      /reboot - reboot system if needed to complete the operation.\r\n","1309":"\r\n","1310":"    Examples:\r\n","1311":"      Restart device:\r\n","1312":"        pnputil /restart-device \"USB\\VID_045E&PID_00DB\\6&870CE29&0&1\"\r\n","1313":"      Restart all devices with specific hardware/compatible ID:\r\n","1314":"        pnputil /restart-device /deviceid \"USB\\Class_03\"\r\n","1315":"      Restart all devices of a specific class on a specific bus:\r\n","1316":"        pnputil /restart-device /class \"USB\" /bus \"PCI\"\r\n","1317":"\r\n","1341":"  /remove-device [<instance ID> | /deviceid <device ID>] [/class <name | GUID>]\r\n","1342":"                 [/bus <name | GUID>] [/subtree] [/reboot] [/force]\r\n","1343":"\r\n","1344":"    Attempt to remove a device from the system.\r\n","1345":"      /deviceid <device ID> - remove all devices with matching device ID.\r\n","1346":"      /class <name | GUID> - filter by device class name or GUID.\r\n","1347":"      /bus <name | GUID> - filter by bus enumerator name or bus type GUID.\r\n","1348":"      /subtree - remove entire device subtree, including any child devices.\r\n","1349":"      /reboot - reboot system if needed to complete the operation.\r\n","1350":"      /force - remove even if device provides critical system functionality.\r\n","1351":"\r\n","1352":"    Examples:\r\n","1353":"      Remove device:\r\n","1354":"        pnputil /remove-device \"USB\\VID_045E&PID_00DB\\6&870CE29&0&1\"\r\n","1355":"      Remove all devices with specific hardware/compatible ID:\r\n","1356":"        pnputil /remove-device /deviceid \"USB\\Class_03\"\r\n","1357":"      Remove all devices of a specific class on a specific bus:\r\n","1358":"        pnputil /remove-device /class \"USB\" /bus \"PCI\"\r\n","1359":"\r\n","1381":"  /scan-devices [/instanceid <instance ID>] [/async]\r\n","1382":"\r\n","1383":"    Scan the system for any device hardware changes.\r\n","1384":"      /instanceid <instance ID> - scan device subtree for changes.\r\n","1385":"      /async - scan for changes asynchronously.\r\n","1386":"\r\n","1387":"    Examples:\r\n","1388":"      Scan devices:\r\n","1389":"        pnputil /scan-devices\r\n","1390":"\r\n","1400":"    /enum-devicetree [root device instance ID] [/connected] [/services]\r\n","1401":"                     [/stack] [/drivers] [/interfaces]\r\n","1402":"\r\n